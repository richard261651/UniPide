# MARKETPLACE DE EMPRENDIMIENTOS UNINORTE - VARIABLES DE ENTORNO
# ============================================================

# 1. Base de Datos
# Para Desarrollo Local (SQLite sin configuración adicional):
DATABASE_URL="file:./dev.db"

# Para Producción en Vercel (PostgreSQL en Supabase / Neon / Railway / Vercel Postgres):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DBNAME]?sslmode=require"

# 2. Clave secreta para Tokens JWT de Sesión (Genera una clave aleatoria segura)
JWT_SECRET="uninorte-marketplace-jwt-secret-key-2026-super-secure"

# 3. Puerto
PORT=3000
